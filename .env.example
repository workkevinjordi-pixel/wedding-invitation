# Where RSVPs and wishes are saved (see "Google Sheets" in the README).
# Copy this file to .env.local for local work; on Vercel add the same two variables in Project Settings -> Environment Variables.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
GOOGLE_SCRIPT_SECRET=a-long-random-string-you-also-put-in-the-script-properties

# Guest list for the table card (name, pax, table). The sheet's CSV export link; the sheet must be readable by "anyone with the link".
# Format: https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<TAB_ID>
GUEST_SHEET_CSV=https://docs.google.com/spreadsheets/d/XXXXXXXX/export?format=csv&gid=0
